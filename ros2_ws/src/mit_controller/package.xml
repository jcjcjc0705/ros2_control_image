<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mit_controller</name>
  <version>0.1.0</version>
  <description>
    ros2_control controller that forwards mit_msgs/MitCommand to each joint's position,
    velocity, kp, kd and effort command interfaces, and falls back to damping when commands
    stop arriving.
  </description>
  <maintainer email="a0905256272@gmail.com">screamlab</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>mit_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
